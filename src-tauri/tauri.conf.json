{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Panda Torrent",
  "version": "0.1.0",
  "identifier": "com.pandatorrent.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panda Torrent",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,SpareRendererForSitePerProcess"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Panda Torrent",
    "shortDescription": "Быстрый торрент-клиент с библиотекой игр",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "resources/mpv/libmpv-2.dll": "mpv/libmpv-2.dll"
    },
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent",
        "description": "Торрент-файл",
        "role": "Editor",
        "mimeType": "application/x-bittorrent"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMDAwMjU5MUM3RjMyMDgKUldRSU1uOGNXUUlBV2pSNGh4UWIvanQ0UDc2RFVhdXBQcjVFRitNbThEUi9haEEybVdjTEJCeG4K",
      "endpoints": [
        "https://github.com/Pandarens/pandatorrent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
